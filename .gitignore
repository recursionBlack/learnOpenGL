# ============================================================================
#  LearnOpenGL - TEST project  .gitignore
# ============================================================================

# ---- CMake / Ninja build output -------------------------------------------
# Covers build/, build-release/, build-vs/, ... whatever build dir you create.
/build/
/build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log

# ---- Compiled artefacts (in case you compile by hand) ----------------------
*.obj
*.o
*.exe
*.lib
*.pdb
*.ilk
*.exp

# ---- Visual Studio ---------------------------------------------------------
.vs/
*.sln
*.vcxproj
*.vcxproj.filters

# ---- Tooling / editor caches ----------------------------------------------
.omo/
.codegraph/
.cache/
.vscode/ipch/
# VSCode local editor config (machine-specific, not shared)
.vscode/settings.json
.vscode/c_cpp_properties.json

# ---- OS / editor noise -----------------------------------------------------
Thumbs.db
Desktop.ini
*~

# NOTE: .vscode/ is kept, but settings.json and c_cpp_properties.json are
# ignored -- they are machine-specific local editor config, not shared.
